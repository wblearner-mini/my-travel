<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere. The app's own server (self-signed, server/make_cert.sh) is trusted only for its own
     addresses, and only by that certificate: a system CA can't stand in for it there.
     This copy lists only this machine's loopback addresses. The real host addresses (LAN, Tailscale) go in
     app/local-res/xml/network_security_config.xml, which is git-ignored and replaces this file when present. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="@raw/mytravel_server_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
