<?xml version="1.0" encoding="utf-8"?>
<!-- Trips may be backed up; the session token and self-typed AI keys never leave the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="ai.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="ai.xml" />
    </device-transfer>
</data-extraction-rules>
